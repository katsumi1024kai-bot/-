{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "japanese",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -v)",
      "Bash(git branch --list*)",
      "Bash(git show*)",
      "Bash(git remote -v)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(pwd)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(which *)",
      "Bash(npm run*)",
      "Bash(npm test*)",
      "Bash(yarn run*)",
      "Bash(yarn test*)",
      "Bash(pnpm run*)",
      "Bash(pnpm test*)",
      "Read",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(git checkout -- *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)"
    ]
  }
}
